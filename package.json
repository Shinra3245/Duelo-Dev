{
  "name": "duelodev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Duelos de programación en tiempo real",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "api",
    "realtime",
    "web"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @duelodev/shared",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "dev": "./scripts/dev.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "tournament:preflight": "./scripts/tournament-preflight.sh",
    "tournament:start": "./scripts/tournament-start.sh",
    "judge:vm:start": "./scripts/judge-vm-worker-start.sh",
    "judge:vm:stop": "./scripts/judge-vm-worker-stop.sh",
    "tournament:smoke": "node ./scripts/tournament-smoke.mjs",
    "tournament:status": "./scripts/tournament-status.sh",
    "tournament:stop": "./scripts/tournament-stop.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  }
}
