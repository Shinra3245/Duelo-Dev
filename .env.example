# ─────────────────────────────────────────────────────────────
# DueloDev — plantilla de entorno. Copia a `.env` y rellena.
# NUNCA commitees `.env`. Los secretos de producción son DISTINTOS
# de los de desarrollo (doc 06 §4).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── PostgreSQL ──
# Puertos no estándar a propósito: así el stack convive con otros
# proyectos que ya usen 5432/6379 en la misma máquina.
POSTGRES_USER=duelodev
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=duelodev
POSTGRES_PORT=5433
DATABASE_URL=postgres://duelodev:cambiame_en_local@localhost:5433/duelodev

# ── Redis ──
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ── API ──
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Genera con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Orígenes permitidos para CORS, separados por coma (nunca `*` con credenciales).
CORS_ORIGINS=http://localhost:3000

# ── Realtime ──
REALTIME_PORT=3002
REALTIME_PUBLIC_URL=http://localhost:3002

# ── Web ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3002

# ── OAuth Google (D4) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Juez ──
# El worker NO corre con acceso al socket de Docker en el mismo
# contenedor que los secretos de la API (contexto H2 / doc 06 §2).
JUDGE_WORKERS=3
JUDGE_IMAGE=duelodev/ubuntu-judge:latest
# El arranque LAN no activa la VM por defecto; para un torneo real exige
# START_JUDGE_VM=1 y REQUIRE_JUDGE_VM=1 después de validar la VM rootless.
START_JUDGE_VM=0
REQUIRE_JUDGE_VM=0
